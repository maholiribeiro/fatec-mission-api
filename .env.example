# Copie este arquivo para .env e preencha os valores. O .env NÃO deve ser versionado.

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados MySQL (obrigatórias: DB_HOST, DB_USER, DB_NAME)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fatec_mission
DB_CONNECTION_LIMIT=10
# true para bancos na nuvem que exigem SSL (ex.: Aiven)
DB_SSL=false

# Cria o banco e as tabelas ao iniciar a API (idempotente)
DB_AUTO_INIT=true
# Insere o administrador e as missões de exemplo (use true só na primeira execução)
DB_AUTO_SEED=false

# Autenticação (obrigatória: JWT_SECRET — use um valor longo e aleatório)
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Administrador criado pelo seed
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@fatec.sp.gov.br
ADMIN_PASSWORD=
